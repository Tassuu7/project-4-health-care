# AegisCare Enterprise Patient Management System - Environment Configuration
# Copy this file to .env and customize for your deployment environment

# Application Settings
APP_NAME=AegisCare Enterprise Patient Management Platform
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=aegiscare_super_secure_enterprise_secret_key_change_in_production_2026
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://localhost:8000

# Database Configuration (SQLite default for embedded zero-config, PostgreSQL supported)
DATABASE_URL=sqlite:///./aegiscare_health.db
DB_ECHO_SQL=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security & JWT Tokens
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ROUNDS=12

# Healthcare Compliance & Security
HIPAA_AUDIT_LOG_ENABLED=true
DATA_MASKING_ENABLED=true
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Clinical Engine Settings
ENABLE_AI_TRIAGE_ASSIST=false
DEFAULT_TRIAGE_PROTOCOL=ESI_V4
ENABLE_DRUG_INTERACTION_CHECK=true
ENABLE_CRITICAL_LAB_ALERTS=true

# Notification Dispatch (Simulated in development)
NOTIFICATION_DRIVER=in_memory
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=notifications@aegiscarehealth.local
